# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=CropWeedAI
APP_ENV=development          # development | production
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cropweed:cropweed@localhost:5432/cropweedai

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local        # local | s3
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── ML Model ────────────────────────────────────────────────────────────────
# Set this to the full path of your trained U-Net checkpoint (.pth/.pt) when ready.
# Leave empty to run without model (model-unavailable state will be reported).
UNET_CHECKPOINT_PATH=./unet_best.pt 
UNET_NUM_CLASSES=3           # 0=Background, 1=Crop, 2=Weed
UNET_INPUT_SIZE=512          # Square input dimension used during training
UNET_DEVICE=cpu              # cpu | cuda

# ─── Email (Password Reset) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@cropweedai.com

# ─── S3 (optional, only used when STORAGE_BACKEND=s3) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
